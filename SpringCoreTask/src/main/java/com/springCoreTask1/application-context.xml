	<bean id="motor1" class="com.springCoreTask1.Motor">
		<property name="motorId" value="101"/>
		<property name="motorType" value="Battery"/>
	</bean>
	
	<bean id="toyCar1" class="com.springCoreTask1.ToyCar">
		<property name="toyCarId" value="1001"/>
		<property name="toyCarBrand" value="MatchBox"/>
		<property name="motor" ref="motor1"/>
	</bean>
	
	<bean id="motor2" class="com.springCoreTask1.Motor">
		<constructor-arg value="102"/>
		<constructor-arg value="Patrol"/>
	</bean>
	
	<bean id="toyCar2" class="com.springCoreTask1.ToyCar">
		<constructor-arg value="1002"/>
		<constructor-arg value="Hot Wheal"/>
		<constructor-arg ref="motor2"/>
	</bean>
