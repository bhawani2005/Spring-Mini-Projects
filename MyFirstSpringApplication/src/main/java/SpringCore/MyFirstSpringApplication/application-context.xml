<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- bean definitions here -->
    <bean id="person" class="SpringCore.MyFirstSpringApplication.Person">
    <!-- this process is called seter injection  -->
    	<!-- <property name="name" value="Kumar"></property>
    	<property name="age" value="22"></property> -->
    	
    	<constructor-arg value="Kumar"></constructor-arg>
    	<constructor-arg value="26"></constructor-arg>
    </bean>

</beans>